+inline std::string read_text_file(const std::string& path) {
+    std::ifstream file(path);
+    std::stringstream contents;
+    contents << file.rdbuf();
+    return contents.str();
+}
+inline std::vector<int> parse_cpu_list(const std::string& text) {
+    std::vector<int> cpus;
+    std::stringstream parts(text);
+    std::string part;
+    while (std::getline(parts, part, ',')) {
+        if (part.empty() || part == "\n") continue;
+        const size_t dash = part.find('-');
+        const int first = std::atoi(part.c_str());
+        const int last = dash == std::string::npos ? first : std::atoi(part.c_str() + dash + 1);
+        for (int cpu = first; cpu <= last; ++cpu) cpus.push_back(cpu);
+    }
+    return cpus;
+}
+inline std::vector<std::vector<Core>> node_threads() {
+#if defined(_WIN32)
+    std::vector<std::vector<Core>> nodes = node_core_threads();
+#else
+    std::vector<std::vector<Core>> nodes;
+    cpu_set_t allowed;
+    CPU_ZERO(&allowed);
+    const bool have_mask = sched_getaffinity(0, sizeof allowed, &allowed) == 0;
+    auto ok = [&](int cpu) { return cpu >= 0 && (!have_mask || (cpu < CPU_SETSIZE && CPU_ISSET(cpu, &allowed))); };
+    const std::vector<int> pcores = parse_cpu_list(read_text_file("/sys/devices/cpu_core/cpus"));
+    const bool hybrid = !pcores.empty() && !read_text_file("/sys/devices/cpu_atom/cpus").empty();
+    for (int node = 0; node < 64; ++node) {
+        const std::string list = read_text_file("/sys/devices/system/node/node" + std::to_string(node) + "/cpulist");
+        if (list.empty()) break;
+        std::vector<Core> cores;
+        std::vector<int> seen;
+        for (int cpu : parse_cpu_list(list)) {
+            if (!ok(cpu)) continue;
+            std::vector<int> siblings = parse_cpu_list(read_text_file(
+                "/sys/devices/system/cpu/cpu" + std::to_string(cpu) + "/topology/thread_siblings_list"));
+            if (siblings.empty()) siblings = {cpu};
+            if (std::find(seen.begin(), seen.end(), siblings[0]) != seen.end()) continue;
+            seen.push_back(siblings[0]);
+            Core core;
+            for (int sibling : siblings)
+                if (ok(sibling)) core.cpus.push_back(sibling);
+            if (core.cpus.empty()) continue;
+            core.eff = hybrid && std::find(pcores.begin(), pcores.end(), core.cpus[0]) != pcores.end() ? 1 : 0;
+            cores.push_back(core);
+        }
+        if (!cores.empty()) nodes.push_back(cores);
+    }
+#endif
+    if (nodes.empty()) {
+        std::vector<Core> all;
+        for (unsigned cpu = 0; cpu < std::max(1u, std::thread::hardware_concurrency() / 2); ++cpu)
+            all.push_back({{(int) cpu}, 0});
+        nodes.push_back(all);
+    }
+    return nodes;
+}
