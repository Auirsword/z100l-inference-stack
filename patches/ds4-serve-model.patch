+def model_request_error(request, current):
+    model = request.get("model")
+    if not isinstance(model, str) or not model:
+        return 400, {"error": {"type": "invalid_request_error", "param": "model",
+                               "message": "model is required and must be a nonempty string"}}
+    if model != current:
+        return 404, {"error": {"type": "invalid_request_error", "param": "model", "code": "model_not_found",
+                               "message": f"model not found: {model}"}}
+    return None
