+/// 0: unset or off, 1: on, -1: invalid (model loading must reject it).
+inline int parse(const char* value) {
+    if (value == nullptr || std::strcmp(value, "0") == 0) return 0;
+    return std::strcmp(value, "1") == 0 ? 1 : -1;
+}
