+    cudaError_t trace_canonical(const Layer& l, const Dev& d, int expert, const x3::Mat& gate,
+                                const float* h_input, const float* gathered, cudaStream_t stream) {
+        const int k = gate.k, n = gate.n;
+        std::vector<uint8_t> cpu((size_t) (k / 256) * 292);
+        ggml_cpu_init();
+        gg::iq_cpu_quant(15, h_input, k, cpu.data());
+        int8_t* q = nullptr;
+        float* scales = nullptr;
+        float* y = nullptr;
+        cudaError_t status = cudaMalloc((void**) &q, (size_t) k);
+        if (status == cudaSuccess) status = cudaMalloc((void**) &scales, (size_t) (k / 32) * sizeof(float));
+        if (status == cudaSuccess) status = cudaMalloc((void**) &y, (size_t) n * sizeof(float));
+        if (status != cudaSuccess) return status;
+        gg::act_q8k(gathered, 1, k, q, scales, stream);
+        status = cudaStreamSynchronize(stream);
+        if (status != cudaSuccess) return status;
+        std::vector<int8_t> gpu_q((size_t) k);
+        std::vector<float> gpu_d((size_t) k / 32), gpu_y((size_t) n);
+        status = cudaMemcpy(gpu_q.data(), q, (size_t) k, cudaMemcpyDeviceToHost);
+        if (status == cudaSuccess) status = cudaMemcpy(gpu_d.data(), scales, gpu_d.size() * 4, cudaMemcpyDeviceToHost);
+        if (status != cudaSuccess) return status;
+        size_t q_bad = 0, d_bad = 0, first_q = (size_t) k;
+        for (int b = 0; b < k / 256; ++b) {
+            const uint8_t* block = cpu.data() + (size_t) b * 292;
+            for (int j = 0; j < 256; ++j)
+                if (gpu_q[(size_t) b * 256 + j] != (const int8_t) block[4 + j]) {
+                    ++q_bad;
+                    if (first_q == (size_t) k) first_q = (size_t) b * 256 + j;
+                }
+            for (int j = 0; j < 8; ++j) d_bad += std::memcmp(block, &gpu_d[(size_t) b * 8 + j], 4) != 0;
+        }
+        std::vector<float> source((size_t) k);
+        status = cudaMemcpy(source.data(), gathered, (size_t) k * sizeof(float), cudaMemcpyDeviceToHost);
+        if (status != cudaSuccess) return status;
+        size_t source_bad = 0;
+        for (int i = 0; i < k; ++i) source_bad += std::memcmp(&source[(size_t) i], &h_input[(size_t) i], 4) != 0;
+        std::fprintf(stderr, "DS4_ACT layer %d expert %d: q8 mismatches %zu, scale mismatches %zu, input mismatches %zu\n",
+                     l.il, expert, q_bad, d_bad, source_bad);
+        if (first_q < (size_t) k) {
+            const int block = (int) (first_q / 256), j = (int) (first_q % 256);
+            int at = 0;
+            const float* row = h_input + (size_t) block * 256;
+            for (int i = 1; i < 256; ++i)
+                if (std::fabs(row[i]) > std::fabs(row[at])) at = i;
+            const float maximum = row[at], iscale = -127.0f / maximum, ratio = iscale * row[j];
+            uint32_t xb = 0, rb = 0;
+            std::memcpy(&xb, &row[j], 4);
+            std::memcpy(&rb, &ratio, 4);
+            std::fprintf(stderr,
+                         "DS4_ACT first %d block %d index %d: x %.17g (%08x), max %.17g, ratio %.17g (%08x), CPU q %d GPU q %d\n",
+                         (int) first_q, block, j, row[j], xb, maximum, ratio, rb, cpu[(size_t) block * 292 + 4 + j],
+                         gpu_q[first_q]);
+        }
+        gg::iq::MvJob j;
+        j.w = (const uint8_t*) gate.raw;
+        j.ld = gg::type_row_bytes(gate.gg_type, k);
+        j.type = gate.gg_type;
+        j.k = k;
+        j.n = n;
+        j.xq = q;
+        j.xd = scales;
+        j.y = y;
+        j.ycs = n;
+        const bool launched = gg::iq::mv(&j, 1, stream, true);
+        status = cudaStreamSynchronize(stream);
+        if (status != cudaSuccess) return status;
+        status = cudaMemcpy(gpu_y.data(), y, (size_t) n * 4, cudaMemcpyDeviceToHost);
+        if (status != cudaSuccess) return status;
+        const uint8_t* host = mx_mat(l, expert, 0);
+        const size_t row = gg::type_row_bytes(gate.gg_type, k);
+        size_t bad = 0, first = (size_t) n;
+        float worst = 0.0f;
+        for (int r = 0; r < n; ++r) {
+            float expected = 0.0f;
+            ggml_get_type_traits_cpu((ggml_type) gate.gg_type)->vec_dot(k, &expected, 0, host + (size_t) r * row, 0,
+                                                                       cpu.data(), 0, 1);
+            const float error = std::fabs(expected - gpu_y[(size_t) r]);
+            if (std::memcmp(&expected, &gpu_y[(size_t) r], 4) != 0) {
+                ++bad;
+                if (first == (size_t) n) first = (size_t) r;
+            }
+            worst = std::max(worst, error);
+        }
+        std::fprintf(stderr, "DS4_CANONICAL layer %d expert %d: %s (%zu/%d, max %.9g, launched %d)\n", l.il, expert,
+                     bad ? "MISMATCH" : "match", bad, n, worst, (int) launched);
+        if (bad) {
+            float expected = 0.0f;
+            ggml_get_type_traits_cpu((ggml_type) gate.gg_type)->vec_dot(k, &expected, 0, host + first * row, 0,
+                                                                       cpu.data(), 0, 1);
+            std::fprintf(stderr, "DS4_CANONICAL first row %zu: GPU %.9g CPU %.9g\n", first, gpu_y[first], expected);
+        }
+        cudaFree(q), cudaFree(scales), cudaFree(y);
+        return launched ? cudaSuccess : cudaErrorUnknown;
+    }
