+template <int T>
+__device__ __forceinline__ float canonical_row(const uint8_t* w, const int8_t* xq, const float* xd, int k) {
+    static_assert(T == kIQ2_XXS || T == kIQ2_S || T == kIQ3_XXS || T == kIQ3_S,
+                  "the canonical reference covers Maya-S's four expert formats");
+    const uint32_t* tab = T == kIQ2_XXS ? (const uint32_t*) iq2xxs_grid
+                         : T == kIQ2_S   ? (const uint32_t*) iq2s_grid
+                         : T == kIQ3_XXS ? (const uint32_t*) iq3xxs_grid
+                                         : (const uint32_t*) iq3s_grid;
+    float lanes[8] = {};
+    for (int kb = 0; kb < k / 32; kb += 8) {
+        int sums[8] = {};
+#pragma unroll
+        for (int sub = 0; sub < 8; ++sub) {
+            Sub s;
+            decode<T>(w, kb + sub, tab, s);
+            const int8_t* x = xq + (kb + sub) * 32;
+#pragma unroll
+            for (int j = 0; j < 8; ++j) sums[j] += (j < 4 ? s.s0 : s.s1) * __dp4a(s.q[j], ((const int*) x)[j], 0);
+        }
+        const float d = fmul_no_fma(h2f(w + (size_t) (kb >> 3) * Ty<T>::B), xd[kb]);
+#pragma unroll
+        for (int j = 0; j < 8; ++j) lanes[j] = fma_no_contract(d, (float) sums[j], lanes[j]);
+    }
+    const float a = __fadd_rn(__fadd_rn(lanes[4], lanes[0]), __fadd_rn(lanes[6], lanes[2]));
+    const float b = __fadd_rn(__fadd_rn(lanes[5], lanes[1]), __fadd_rn(lanes[7], lanes[3]));
+    return (T == kIQ2_XXS || T == kIQ2_S ? 0.125f : T == kIQ3_XXS ? 0.25f : 1.0f) * __fadd_rn(a, b);
+}
