+void test_deterministic_math(cudaStream_t s) {
+    const std::vector<float> gate = {-10.0f, -3.0f, -1.0f, -0.5f, 0.0f, 0.5f, 1.0f, 3.0f, 10.0f};
+    const std::vector<float> up = {0.25f, -2.0f, 3.0f, 0.75f, 1.0f, -0.125f, 0.5f, -1.0f, 2.0f};
+    std::vector<float> want(gate.size());
+    for (size_t i = 0; i < gate.size(); ++i) want[i] = gg::deterministic::swiglu(gate[i], up[i], 10.0f);
+    float* dg = dev(gate);
+    float* du = dev(up);
+    float* dh = dev(std::vector<float>(gate.size(), 0.0f));
+    strata::ds4::swiglu_deterministic(dg, du, (int) gate.size(), 10.0f, dh, s);
+    CU(cudaStreamSynchronize(s));
+    const std::vector<float> got = host(dh, gate.size());
+    if (bit_differences(got, want, "deterministic SwiGLU on identical inputs")) ++g_fail;
+    for (size_t i = 0; i < got.size(); ++i)
+        if (std::memcmp(&got[i], &want[i], 4) != 0)
+            std::printf("  math[%zu] gate %.9g up %.9g GPU %.9g CPU %.9g\n", i, gate[i], up[i], got[i], want[i]);
+    cudaFree(dg), cudaFree(du), cudaFree(dh);
