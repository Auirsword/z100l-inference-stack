+int bit_differences(const std::vector<float>& got, const std::vector<float>& want, const char* label) {
+    int bad = 0, first = -1;
+    for (size_t i = 0; i < got.size(); ++i)
+        if (std::memcmp(&got[i], &want[i], sizeof(float)) != 0) {
+            ++bad;
+            if (first < 0) first = (int) i;
+        }
+    if (first >= 0) {
+        uint32_t a, b;
+        std::memcpy(&a, &got[(size_t) first], 4);
+        std::memcpy(&b, &want[(size_t) first], 4);
+        std::printf("%s: first %d GPU %.9g (%08x), CPU %.9g (%08x)\n", label, first, got[(size_t) first], a,
+                    want[(size_t) first], b);
+    }
+    std::printf("%-64s %s (%d of %zu)\n", label, bad ? "FAIL" : "bitwise OK", bad, got.size());
+    return bad;
+}
