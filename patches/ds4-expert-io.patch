+        const char* enabled = std::getenv("DS4_TRACE_IO");
+        if (enabled == nullptr || std::atoi(enabled) != layer) return cudaSuccess;
+        std::vector<T> host((size_t) count);
+        const cudaError_t copied = cudaMemcpyAsync(host.data(), values, host.size() * sizeof(T), cudaMemcpyDeviceToHost, stream);
+        if (copied != cudaSuccess) return copied;
+        const cudaError_t completed = cudaStreamSynchronize(stream);
+        if (completed != cudaSuccess) return completed;
+        std::vector<float> encoded(host.begin(), host.end());
+        trace_expert_io(layer, token, expert, role, encoded.data(), count);
+        return cudaSuccess;
+    }
