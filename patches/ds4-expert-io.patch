+    void trace_expert_io(int layer, int token, int expert, int role, const float* values, int count) const {
+        const char* enabled = std::getenv("DS4_TRACE_IO");
+        const char* path = std::getenv("DS4_TRACE_IO_FILE");
+        if (enabled == nullptr || path == nullptr || std::atoi(enabled) != layer) return;
+        std::FILE* f = std::fopen(path, "ab");
+        if (f == nullptr) return;
+        const int header[5] = {layer, token, expert, role, count};
+        std::fwrite(header, 4, 5, f);
+        std::fwrite(values, 4, (size_t) count, f);
+        std::fclose(f);
+    }
+    cudaError_t trace_device_io(int layer, int token, int expert, int role, const float* values, int count,
+                                cudaStream_t stream) const {
+        const char* enabled = std::getenv("DS4_TRACE_IO");
+        if (enabled == nullptr || std::atoi(enabled) != layer) return cudaSuccess;
+        std::vector<float> host((size_t) count);
+        const cudaError_t copied = cudaMemcpyAsync(host.data(), values, host.size() * 4, cudaMemcpyDeviceToHost, stream);
+        if (copied != cudaSuccess) return copied;
+        const cudaError_t completed = cudaStreamSynchronize(stream);
+        if (completed != cudaSuccess) return completed;
+        trace_expert_io(layer, token, expert, role, host.data(), count);
+        return cudaSuccess;
+    }
+    template <class T>
+    cudaError_t trace_integer_io(int layer, int token, int expert, int role, const T* values, int count,
