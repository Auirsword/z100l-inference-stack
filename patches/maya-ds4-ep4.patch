+    bool place_ep4(std::string& err) {
+        if (L.size() != 40 || devs.size() != 4) {
+            err = "EP4 placement requires 40 layers and four devices";
+            return false;
+        }
+        for (const Layer& l : L)
+            if (l.n_cls != 1 || l.lay.fmt != gg::kFmtMXFP4 || l.nm != 1 || l.dev != 0) {
+                err = "EP4 supports only single-layout GGUF experts with every trunk layer on CUDA0";
+                return false;
+            }
+        if (!ep_open(err)) return false;
+        std::array<double, 4> room = {}, used = {};
+        for (int rank = 0; rank < 4; ++rank) {
+            Dev& d = devs[(size_t) rank];
+            CK(cudaSetDevice(d.id));
+            size_t fr = 0, tot = 0;
+            CK(mem_info(&fr, &tot));
+            room[(size_t) rank] = std::max(0.0, (double) fr - (double) ((size_t) o.reserve_mib << 20)) * o.vram_experts;
+        }
+        std::vector<std::array<int, 4>> hot(L.size());
+        for (int rank = 0; rank < 4; ++rank) {
+            double want = 0;
+            for (const Layer& l : L) want += (double) l.blob * (l.n_exp / 4);
+            const double frac = want > 0 ? std::min(1.0, room[(size_t) rank] / want) : 0.0;
+            for (size_t il = 0; il < L.size(); ++il) {
+                Layer& l = L[il];
+                hot[il][(size_t) rank] = std::min(l.n_exp / 4, (int) std::floor(frac * (l.n_exp / 4)));
+                used[(size_t) rank] += (double) hot[il][(size_t) rank] * l.blob;
+            }
+            for (size_t il = 0; il < L.size(); ++il) {
+                Layer& l = L[il];
+                while (hot[il][(size_t) rank] < l.n_exp / 4 &&
+                       used[(size_t) rank] + l.blob <= room[(size_t) rank]) {
+                    ++hot[il][(size_t) rank];
+                    used[(size_t) rank] += l.blob;
+                }
+            }
+        }
+        for (int rank = 1; rank < 4; ++rank) {
+            int total = 0;
+            for (const auto& layer : hot) total += layer[(size_t) rank];
+            if (total == 0) {
+                err = "EP4 rank " + std::to_string(rank) + " has no VRAM for any owner-hot expert; refusing a CPU-only fallback";
+                return false;
+            }
+        }
+        for (size_t il = 0; il < L.size(); ++il) {
+            Layer& l = L[il];
+            l.slot.assign((size_t) l.n_exp, -1);
+            l.host.assign((size_t) l.n_exp, nullptr);
+            l.hh.assign((size_t) l.n_exp, {nullptr, nullptr, nullptr, nullptr});
+            l.vm.assign((size_t) l.n_exp, {});
+            l.ram.clear();
+            l.n_vram = l.n_slots = l.n_main = l.pv_n = hot[il][0];
+            l.spare_vram = -1;
+            l.rc_base = -1;
+            l.rc_n = 0;
+            l.swap_pending = false;
+            l.cpu_hits.clear();
+            l.heat.assign((size_t) l.n_exp, 0.0f);
+            const uint32_t* p = prof.data() + (size_t) l.il * g.n_exp;
+            double sum = 0;
+            for (int e = 0; e < l.n_exp; ++e) sum += p[e];
+            const double scale = sum > 0 ? 512.0 / sum : 0.0;
+            for (int e = 0; e < l.n_exp; ++e) l.heat[(size_t) e] = (float) (p[e] * scale);
+            for (int rank = 1; rank < 4; ++rank) {
+                EpOwnerLayer& ol = ep_workers[(size_t) rank]->layers[il];
+                ol.slot.assign((size_t) l.n_exp, -1);
+                ol.vm.assign((size_t) (l.n_exp / 4), {});
+                ol.n_hot = hot[il][(size_t) rank];
+            }
+            for (int rank = 0; rank < 4; ++rank) {
+                std::vector<int> order((size_t) (l.n_exp / 4));
+                std::iota(order.begin(), order.end(), rank * (l.n_exp / 4));
+                std::stable_sort(order.begin(), order.end(), [&](int a, int b) { return p[a] > p[b]; });
+                for (int i = 0; i < hot[il][(size_t) rank]; ++i) {
+                    const int e = order[(size_t) i];
+                    if (rank == 0) l.slot[(size_t) e] = i;
+                    else ep_workers[(size_t) rank]->layers[il].slot[(size_t) e] = i;
+                }
+            }
+            if (l.n_vram > 0) {
+                Dev& d = devs[0];
+                CK(cudaSetDevice(d.id));
+                void* v = nullptr;
+                if (cudaMalloc(&v, (size_t) l.n_vram * l.blob) != cudaSuccess) {
+                    err = "EP4 main-hot allocation at layer " + std::to_string(l.il) + " failed";
+                    return false;
+                }
+                d.allocs.push_back(v);
+                d.experts += (size_t) l.n_vram * l.blob;
+                l.vram_base = (uint8_t*) v;
+            }
+            for (int e = 0; e < l.n_exp; ++e)
+                if (l.slot[(size_t) e] >= 0) set_vm_view(l, e, sat(l, l, l.slot[(size_t) e], l.blob), l.vm[(size_t) e]);
+            for (int rank = 1; rank < 4; ++rank) {
+                Dev& d = devs[(size_t) rank];
+                EpOwnerLayer& ol = ep_workers[(size_t) rank]->layers[il];
+                if (ol.n_hot > 0) {
+                    CK(cudaSetDevice(d.id));
+                    void* v = nullptr;
+                    if (cudaMalloc(&v, (size_t) ol.n_hot * l.blob) != cudaSuccess) {
+                        err = "EP4 owner-hot allocation at rank " + std::to_string(rank) + " layer " +
+                              std::to_string(l.il) + " failed";
+                        return false;
+                    }
+                    d.allocs.push_back(v);
+                    d.experts += (size_t) ol.n_hot * l.blob;
+                    ol.base = (uint8_t*) v;
+                }
+                for (int e = rank * (l.n_exp / 4); e < (rank + 1) * (l.n_exp / 4); ++e)
+                    if (ol.slot[(size_t) e] >= 0)
+                        set_vm_view(l, e, ol.base + (size_t) ol.slot[(size_t) e] * l.blob,
+                                    ol.vm[(size_t) (e - rank * (l.n_exp / 4))]);
+            }
+            for (int e = 0; e < l.n_exp; ++e) {
+                bool owner_hot = false;
+                for (int rank = 1; rank < 4; ++rank)
+                    owner_hot = owner_hot || ep_workers[(size_t) rank]->layers[il].slot[(size_t) e] >= 0;
+                if (l.slot[(size_t) e] < 0 && !owner_hot) l.host[(size_t) e] = (uint8_t*) mx_mat(l, e, 0);
+            }
+            if (!halloc(l.tab_pin, 2, err)) return false;
+            std::vector<unsigned long long> table((size_t) l.n_exp, 0ull);
+            for (int e = 0; e < l.n_exp; ++e)
+                if (l.slot[(size_t) e] >= 0) table[(size_t) e] = (unsigned long long) sat(l, l, l.slot[(size_t) e], l.blob);
+            CK(cudaSetDevice(devs[0].id));
+            CK(cudaMemcpy(l.vram_tab, table.data(), table.size() * sizeof(unsigned long long), cudaMemcpyHostToDevice));
+        }
+        for (int rank = 0; rank < 4; ++rank) {
+            int count = 0;
+            for (size_t il = 0; il < L.size(); ++il) count += hot[il][(size_t) rank];
+            std::fprintf(stderr, "ds4: EP4 rank %d (CUDA%d): %d fixed owner-hot experts (%.2f GB), owner experts %d..%d\n",
+                         rank, devs[(size_t) rank].id, count, used[(size_t) rank] / 1e9, rank * 96, rank * 96 + 95);
+        }
+        return true;
+    }
