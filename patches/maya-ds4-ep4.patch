+            w.dev = devs[(size_t) rank].id;
+            Dev& d = devs[(size_t) rank];
+            CK(cudaSetDevice(d.id));
+            if (rank == 0) w.st = d.st;
+            else CK(cudaStreamCreateWithFlags(&w.st, cudaStreamNonBlocking));
+            CK(cudaEventCreateWithFlags(&w.ev, cudaEventDisableTiming));
+            if (rank > 0) {
+                if (!x3::prepare(w.st) || !gg::prepare(w.st)) {
+                    err = "EP4 expert scratch on CUDA" + std::to_string(d.id);
+                    return false;
+                }
