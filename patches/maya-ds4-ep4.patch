+    void ep_finish(EpWorker& w, bool ok, const std::string& error) {
+        {
+            std::lock_guard<std::mutex> lk(w.mu);
+            if (ok) {
+                w.recorded = w.job.seq;
+                w.at.store("event recorded", std::memory_order_release);
+            } else {
+                w.error = error.empty() ? "EP4 job failed" : error;
+                w.at.store("error", std::memory_order_release);
+            }
+            w.busy = false;
+        }
+        w.cv.notify_all();
+    }
+
+    void ep_loop(EpWorker& w) {
+        for (;;) {
+            {
+                std::unique_lock<std::mutex> lk(w.mu);
+                w.cv.wait(lk, [&] { return w.quit || w.busy; });
+                if (w.quit) return;
+            }
+            w.at.store("running", std::memory_order_release);
+            std::string error;
+            const bool ok = ep_run(w, error);
+            ep_finish(w, ok, error);
+        }
+    }
+
+    void ep_start() {
+        for (auto& wp : ep_workers) {
+            EpWorker* w = wp.get();
+            if (w->rank > 0) w->th = std::thread([this, w] { ep_loop(*w); });
+        }
+    }
