+    bool ep_wait(ep::Completion& completion, const std::array<bool, 4>& has_work, unsigned seq, int layer,
+                 std::string& err) {
+        std::array<bool, 4> done = {};
+        const double deadline = now_ms() + kEpWaitMs;
+        for (;;) {
+            if ((cancel && cancel()) || halt.load(std::memory_order_acquire))
+                return ep_fail(err, "EP4 stopped at layer " + std::to_string(layer) + " seq " + std::to_string(seq));
+            bool all = true;
+            for (int rank = 0; rank < 4; ++rank) {
+                if (done[(size_t) rank]) continue;
+                EpWorker& w = *ep_workers[(size_t) rank];
+                unsigned recorded = 0;
+                std::string error;
+                {
+                    std::lock_guard<std::mutex> lk(w.mu);
+                    recorded = w.recorded;
+                    error = w.error;
+                }
+                if (!error.empty())
+                    return ep_fail(err, "EP4 rank " + std::to_string(rank) + " layer " + std::to_string(layer) +
+                                        " seq " + std::to_string(seq) + ": " + error);
+                if (recorded != seq) {
+                    all = false;
+                    if (recorded > seq)
+                        return ep_fail(err, "EP4 rank " + std::to_string(rank) + " sequence advanced past " +
+                                            std::to_string(seq));
+                    continue;
+                }
+                cudaSetDevice(devs[(size_t) rank].id);
+                const cudaError_t q = cudaEventQuery(w.ev);
+                if (q == cudaErrorNotReady) {
+                    all = false;
+                    continue;
+                }
+                if (q != cudaSuccess)
+                    return ep_fail(err, "EP4 rank " + std::to_string(rank) + " layer " + std::to_string(layer) +
+                                        " seq " + std::to_string(seq) + ": " + cudaGetErrorString(q));
+                if (rank > 0 && has_work[(size_t) rank] && w.job.nrows > 0) {
+                    if (w.h_full == nullptr) return ep_fail(err, "EP4 owner has no full pinned output buffer");
+                    // These reads precede combine on the main stream.  The next layer's route sync completes them before
+                    // this worker can clear h_full for its next job.
+                    cudaSetDevice(devs[0].id);
+                    const int D = g.dim;
+                    for (int i = 0; i < w.job.nrows; ++i) {
+                        const int row = w.job.scatter.src[i];
+                        if (row < 0 || row >= w.job.T * kPicks)
+                            return ep_fail(err, "EP4 H2D row out of range at rank " + std::to_string(rank));
+                        // Only this owner's rows are copied: a whole-buffer copy would zero the other owners' rows.
+                        const cudaError_t copy =
+                            cudaMemcpyAsync(devs[0].ed + (size_t) row * D, w.h_full + (size_t) row * D,
+                                            (size_t) D * sizeof(float), cudaMemcpyHostToDevice, devs[0].st);
+                        if (copy != cudaSuccess)
+                            return ep_fail(err, "EP4 host-to-main copy failed at rank " + std::to_string(rank) +
+                                                ": " + cudaGetErrorString(copy));
+                    }
+                }
+                done[(size_t) rank] = true;
+                w.at.store("done", std::memory_order_release);
+                if (has_work[(size_t) rank]) completion.complete_owner(rank);
+            }
+            if (all) return true;
+            if (now_ms() >= deadline) {
+                std::string pending;
+                for (int rank = 0; rank < 4; ++rank)
+                    if (!done[(size_t) rank]) pending += (pending.empty() ? "" : ",") + std::to_string(rank);
+                return ep_fail(err, "EP4 timeout at layer " + std::to_string(layer) + " seq " + std::to_string(seq) +
+                                    " waiting for rank(s) " + pending);
+            }
+            std::this_thread::sleep_for(std::chrono::microseconds(100));
+        }
+    }
