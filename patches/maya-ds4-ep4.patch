+            w.at_seq.store(j.seq, std::memory_order_release);
+            w.busy = true;
+            std::string error;
+            const bool ok = ep_run(w, error);
+            ep_finish(w, ok, error);
+            return true;
+        }
+        {
+            std::lock_guard<std::mutex> lk(w.mu);
+            if (w.busy || !w.error.empty()) {
+                err = "EP4 owner " + std::to_string(w.rank) + " cannot take a new job";
+                return false;
+            }
+            w.job = j;
+            w.at_layer.store(j.layer, std::memory_order_release);
+            w.at_seq.store(j.seq, std::memory_order_release);
+            w.at.store("queued", std::memory_order_release);
+            w.busy = true;
+        }
+        w.cv.notify_all();
+        return true;
+    }
