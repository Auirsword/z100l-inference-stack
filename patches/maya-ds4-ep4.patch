+    bool load_ep4_owners(std::string& err) {
+        struct Job { int rank, layer, expert; };
+        std::vector<Job> jobs;
+        size_t maxb = 0;
+        for (const Layer& l : L) maxb = std::max(maxb, l.blob);
+        for (int rank = 1; rank < 4; ++rank)
+            for (const Layer& l : L)
+                for (int e = rank * (l.n_exp / 4); e < (rank + 1) * (l.n_exp / 4); ++e)
+                    if (ep_workers[(size_t) rank]->layers[(size_t) l.il].slot[(size_t) e] >= 0)
+                        jobs.push_back({rank, l.il, e});
+        std::atomic<size_t> next{0};
+        std::atomic<bool> failed{false};
+        std::mutex mu;
+        std::string why;
+        std::vector<std::thread> threads;
+        for (int t = 0; t < 12 && !jobs.empty(); ++t)
+            threads.emplace_back([&] {
+                uint8_t* stage = nullptr;
+                cudaHostAlloc((void**) &stage, maxb, cudaHostAllocPortable);
+                for (;;) {
+                    const size_t i = next.fetch_add(1);
+                    if (i >= jobs.size() || failed.load()) break;
+                    const Job& j = jobs[i];
+                    const Layer& l = L[(size_t) j.layer];
+                    const EpOwnerLayer& ol = ep_workers[(size_t) j.rank]->layers[(size_t) j.layer];
+                    bool ok = stage != nullptr && read_mx_file(l, j.expert, stage) &&
+                              cudaSetDevice(devs[(size_t) j.rank].id) == cudaSuccess &&
+                              cudaMemcpy(ol.base + (size_t) ol.slot[(size_t) j.expert] * l.blob, stage, l.blob,
+                                         cudaMemcpyHostToDevice) == cudaSuccess;
+                    if (!ok) {
+                        std::lock_guard<std::mutex> lk(mu);
+                        failed.store(true);
+                        why = "EP4 upload rank " + std::to_string(j.rank) + " layer " + std::to_string(j.layer) +
+                              " expert " + std::to_string(j.expert) + " failed";
+                        break;
+                    }
+                }
+                if (stage != nullptr) cudaFreeHost(stage);
+            });
+        for (auto& t : threads) t.join();
+        if (failed.load()) {
+            err = why;
+            return false;
+        }
+        ep_start();
+        return true;
+    }
